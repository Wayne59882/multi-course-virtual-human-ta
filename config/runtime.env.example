# Example only. Existing launchers do not load this file automatically.
# Replace paths, model tags and addresses with the deployment's actual values.
# Keep real credentials in an ignored private environment file.
export VQ_BASE=/absolute/path/to/server-base
export PYTHON_BIN=/absolute/path/to/python
export OLLAMA_HOST=127.0.0.1:11435
export VQ_REFERENCE_EMBED_HOST=127.0.0.1:11438
export VQ_REFERENCE_EMBED_MODEL=bge-m3:latest
export VQ_GEMMA_MODEL_TAG=gemma4:12b
export VQ_MISTRAL_MODEL_TAG=ministral-3:8b-instruct-2512-q4_K_M
export VQ_AUTH_ADMIN_EMAIL=admin@example.com
export VQ_FEEDBACK_TO_EMAIL=admin@example.com
export VQ_PUBLIC_URL=https://your-own-https-host.example
# Configure one mail provider privately using the existing feedback tools.
# Cloud-provider keys are not required by the offline checks.

# Shared-host performance: starting values, not measured optimal settings.
# All teaching processes must inherit the same CPU limits and slot directory.
# GPU sharing is chosen at start-up from free GPU memory (scripts/lib/gpu_capacity.sh);
# set OLLAMA_NUM_PARALLEL / OLLAMA_MAX_LOADED_MODELS or VQ_GPU_SHARING to override.
export VQ_GPU_SHARING=auto            # auto | concurrent | exclusive
export VQ_CPU_WORKERS=4               # OCR/embedding slots while no student is asking
export VQ_CPU_WORKERS_BUSY=2          # ... while students are asking
export VQ_BACKGROUND_PREEMPT=grace    # exclusive mode: grace | immediate | boundary
export VQ_BACKGROUND_GRACE_SEC=12
export VQ_FIGURE_IDLE_SEC=60          # figure reading starts after this much student quiet
export VQ_BACKGROUND_STEP_TIMEOUT_SEC=300
export VQ_LECTURE_MAX_TOKENS=2000
export VQ_STEP_CACHE_REVISION=1
# See docs/performance.md for on-server measurements and checkpoint behavior.
